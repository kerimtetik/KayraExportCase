{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Yarp": "Debug"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/product/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/product" }
        ]
      },
      "log-route": {
        "ClusterId": "log-cluster",
        "Match": {
          "Path": "/log/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/log" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5128/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5164/"
          }
        }
      },
      "log-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5029/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}